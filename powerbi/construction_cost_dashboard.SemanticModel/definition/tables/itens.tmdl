	partition itens = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(Text.TrimEnd(PastaDados, "\") & "\itens.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalho, {{"obra", type text}, {"wbs", Int64.Type}, {"descricao_pt", type text}, {"descricao_original", type text}, {"grupo", type text}, {"unidade", type text}, {"qtd_orcada", type number}, {"qtd_real", type number}, {"orcado", type number}, {"custo_real", type number}, {"saldo", type number}, {"saldo_pct", type number}, {"situacao", type text}, {"efeito_quantidade", type number}, {"efeito_preco", type number}}, "en-US"),
				    Selecao = Table.SelectColumns(Tipos, {"obra", "wbs", "descricao_pt", "descricao_original", "grupo", "unidade", "qtd_orcada", "qtd_real", "orcado", "custo_real", "saldo", "saldo_pct", "situacao", "efeito_quantidade", "efeito_preco"})
				in
				    Selecao

	annotation PBI_ResultType = Table

