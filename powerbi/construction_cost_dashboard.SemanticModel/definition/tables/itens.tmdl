table itens
	lineageTag: b0d2e0b5-876c-4bb2-a530-435ee44a1545

	measure Orçado = SUM(itens[orcado])
		formatString: #,0
		lineageTag: d7ff5eb1-2399-47e3-bcb3-d235941cebe1

	measure 'Custo real' = SUM(itens[custo_real])
		formatString: #,0
		lineageTag: da9912ed-c85e-45b6-a876-ce1eb4d36214

	measure 'Saldo total' = [Orçado] - [Custo real]
		formatString: +#,0;-#,0;0
		lineageTag: f46c53e7-3491-47c0-91d3-6713c762380a

	measure 'Saldo %' = DIVIDE([Saldo total], [Orçado])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: e3354b56-e27b-4efc-9b56-c9000c7aa6d5

	measure 'Qtd de itens' = COUNTROWS(itens)
		formatString: #,0
		lineageTag: 604ba63f-13a2-4ca8-a230-822746f3513f

	measure '% itens acima do orçado' = DIVIDE(CALCULATE(COUNTROWS(itens), itens[situacao] IN {"Estourou", "Não orçado"}), COUNTROWS(itens))
		formatString: 0%
		lineageTag: e07d5997-5903-4832-be62-3e6c27592a88

	measure 'Desvio por custo unitário %' = VAR p = SUMX(itens, ABS(itens[efeito_preco])) VAR q = SUMX(itens, ABS(itens[efeito_quantidade])) RETURN DIVIDE(p, p + q)
		formatString: 0%
		lineageTag: d3749e0f-6f17-42f3-808c-1c8484a2f06a

	measure 'Desvio por quantidade %' = VAR p = SUMX(itens, ABS(itens[efeito_preco])) VAR q = SUMX(itens, ABS(itens[efeito_quantidade])) RETURN DIVIDE(q, p + q)
		formatString: 0%
		lineageTag: 294e5d46-e254-437d-b6d5-57ce8fd6dd2a

