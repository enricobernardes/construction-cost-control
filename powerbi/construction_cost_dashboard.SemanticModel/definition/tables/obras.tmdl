	partition obras = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(Text.TrimEnd(PastaDados, "\") & "\obras.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalho, {{"obra", type text}, {"nome", type text}, {"nome_en", type text}, {"codigo_original", type text}, {"orcado", type number}, {"custo_real", type number}, {"n_itens", Int64.Type}, {"saldo", type number}, {"saldo_pct", type number}, {"inicio", type date}, {"fim", type date}, {"meses", Int64.Type}, {"cpi_final", type number}}, "en-US"),
